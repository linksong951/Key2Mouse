<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 托盘图标依赖 WinForms 的 NotifyIcon -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WindowsInput" Version="6.4.1" />
    <EmbeddedResource Include="Audio\1.wav" />
    <EmbeddedResource Include="Audio\2.wav" />
    <EmbeddedResource Include="Audio\3.wav" />
    <EmbeddedResource Include="Audio\4.wav" />
    <EmbeddedResource Include="Audio\5.wav" />
    <EmbeddedResource Include="Audio\6.wav" />
    <EmbeddedResource Include="Audio\关闭键盘监听.wav" />
    <EmbeddedResource Include="Audio\开启键盘监听.wav" />
    <EmbeddedResource Include="Audio\开启键盘模拟鼠标.wav" />
    <EmbeddedResource Include="Audio\关闭键盘模拟鼠标.wav" />
    <Content Include="功能手册.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>